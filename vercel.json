{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "song.html", "use": "@vercel/static" },
    { "src": "covers/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/api/auth/qr/start",
      "dest": "/api/auth/qr/start.js"
    },
    {
      "src": "/api/auth/qr/status",
      "dest": "/api/auth/qr/status.js"
    },
    {
      "src": "/api/auth/me",
      "dest": "/api/auth/me.js"
    },
    {
      "src": "/api/auth/logout",
      "dest": "/api/auth/logout.js"
    },
    {
      "src": "/api/me/recent-tracks",
      "dest": "/api/me/recent-tracks.js"
    },
    {
      "src": "/api/me/playlists",
      "dest": "/api/me/playlists.js"
    },
    {
      "src": "/api/playlist/tracks",
      "dest": "/api/playlist/tracks.js"
    },
    {
      "src": "/api/track/url",
      "dest": "/api/track/url.js"
    },
    {
      "src": "/api/track/lyric",
      "dest": "/api/track/lyric.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...ncm].js?ncm=$1"
    },
    {
      "src": "/covers/(.*)",
      "dest": "/covers/$1",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/(?:song\\.html)?",
      "dest": "/song.html",
      "headers": {
        "Cache-Control": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800"
      }
    }
  ]
}
